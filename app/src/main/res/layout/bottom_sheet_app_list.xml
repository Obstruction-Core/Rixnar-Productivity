<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#121212">

    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Apps"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="16dp"/>

    <Button
        android:id="@+id/btnSelectApp"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Select App to Block"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#4CAF50"
        android:background="@drawable/btn_outline_bg"
        android:layout_marginBottom="16dp"
        android:textAllCaps="false"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">
        <!-- Manual entry hidden but kept for logic safety -->
        <EditText
            android:id="@+id/etPackage"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:hint="pkg"
            android:inputType="text"/>
        <Button
            android:id="@+id/btnAdd"
            android:layout_width="0dp"
            android:layout_height="0dp"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvApps"
        android:layout_width="match_parent"
        android:layout_height="420dp" />

</LinearLayout>

